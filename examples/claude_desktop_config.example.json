{
  "mcpServers": {
    "filesystem-protected": {
      "command": "gatekeep",
      "args": [
        "--upstream",
        "npx -y @modelcontextprotocol/server-filesystem /path/to/workspace",
        "--db",
        "/tmp/gatekeep_state.db",
        "--shadow"
      ]
    },
    "postgres-protected": {
      "command": "gatekeep",
      "args": [
        "--upstream",
        "npx -y @modelcontextprotocol/server-postgres postgresql://localhost:5432/app",
        "--policy",
        "/path/to/policies.json",
        "--db",
        "/tmp/gatekeep_state.db"
      ]
    }
  }
}
